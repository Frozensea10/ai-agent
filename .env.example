# 必填：至少配置一个 LLM 提供商的 API Key，否则聊天功能不可用
# 可选：OpenAI / DeepSeek / Qwen / Anthropic，配置后会自动进行可用性检测

# OpenAI API Key（推荐用于海外环境）
LLM_OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek API Key（推荐用于国内环境）
LLM_DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 阿里云通义千问 API Key
LLM_QWEN_API_KEY=sk-your-qwen-key-here

# Anthropic Claude API Key
LLM_ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# 可选：自定义 JWT 密钥（生产环境务必修改）
JWT_SECRET=AiAgentPlatformDefaultSecretKey2026!@#$
