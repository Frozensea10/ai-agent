# 必填：至少配置一个 LLM 提供商的 API Key，否则聊天功能不可用
# 可选：OpenAI / DeepSeek / Qwen / Anthropic，配置后会自动进行可用性检测

# OpenAI API Key（推荐用于海外环境）
LLM_OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek API Key（推荐用于国内环境）
LLM_DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 阿里云通义千问 API Key
LLM_QWEN_API_KEY=sk-your-qwen-key-here

# Anthropic Claude API Key
LLM_ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# ==========================================
# 安全相关：生产环境请务必通过环境变量覆盖以下默认值，不要直接使用默认值
# ==========================================

# JWT 签名密钥（请务必替换为足够强度的随机字符串，>=32 字符）
# 注意：所有模块必须使用完全相同的 JWT_SECRET，否则网关鉴权与服务内鉴权会不一致
# 生成示例：openssl rand -base64 48
JWT_SECRET=please-replace-with-your-own-strong-random-secret-key-min-32-chars

# ==========================================
# 数据加密配置
# ==========================================

# 数据库敏感字段（如 LLM API Key）的对称加密密钥
# 必须为 base64 编码的 32 字节(AES-256)密钥，无默认值；未配置时加密/解密功能不可用
# 生成示例：openssl rand -base64 32
# 注意：密钥变更后历史密文将无法解密，请妥善保管并保持稳定
APP_ENCRYPTION_KEY=

# MySQL 数据库密码
MYSQL_PASSWORD=ai_agent123

# ==========================================
# MinIO 对象存储配置
# ==========================================

# MinIO 服务地址
MINIO_ENDPOINT=http://localhost:9000

# MinIO 访问密钥
MINIO_ACCESS_KEY=minio

# MinIO 访问密钥（生产环境请务必修改）
MINIO_SECRET_KEY=minio123

# ==========================================
# 中间件与基础设施地址
# ==========================================

# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口（默认值，通常无需修改）
REDIS_PORT=6379

# Qdrant 向量数据库主机地址
QDRANT_HOST=localhost

# Qdrant 向量数据库端口
QDRANT_GRPC_PORT=6334

# Nacos 注册与配置中心地址
NACOS_SERVER=localhost:8848

# RabbitMQ 主机地址
RABBITMQ_HOST=localhost

# RabbitMQ 端口（默认值，通常无需修改）
RABBITMQ_PORT=5672

# RabbitMQ 用户名
RABBITMQ_USERNAME=guest

# RabbitMQ 密码（生产环境请务必修改）
RABBITMQ_PASSWORD=guest
